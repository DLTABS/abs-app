{
  "manifest_version": 3,
  "name": "ABS — Cầu nối cổng thuế",
  "version": "1.0.0",
  "description": "Chuyển tiếp yêu cầu giữa app.dailythueabs.vn và cổng Dịch vụ công thuế. Không thu thập dữ liệu, không chạy nền.",
  "key": "",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://dichvucong.gdt.gov.vn/*",
    "https://thuedientu.gdt.gov.vn/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "https://app.dailythueabs.vn/*",
      "http://localhost/*"
    ]
  },
  "action": {
    "default_title": "ABS — Cầu nối cổng thuế",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}

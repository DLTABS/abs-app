# Mẫu biến môi trường cho app Đại lý thuế ABS — chép thành .env.local (máy dev) và khai trên
# Vercel (Settings → Environment Variables). KHÔNG commit file .env.local.
# Mọi giá trị phải là của project Supabase/Vercel riêng của ABS, KHÔNG dùng lại khoá của app khác.

# ── Supabase (Project Settings → API) ──
# NEXT_PUBLIC_* lộ ra trình duyệt, chỉ dùng để kiểm tra phiên đăng nhập.
# SUPABASE_SERVICE_ROLE_KEY là khoá TOÀN QUYỀN dữ liệu (bỏ qua RLS) — chỉ dùng phía server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Backup tự động hằng tuần (vercel.json: 19:00 UTC thứ Sáu) ──
# Chuỗi ngẫu nhiên tự sinh, bảo vệ /api/cron/backup khỏi bị gọi bừa. Phải khớp giữa Vercel và
# lệnh gọi tay. ABS KHÔNG gửi email backup nên không cần RESEND_API_KEY.
CRON_SECRET=

# ── Phân hệ Tờ khai: mã tiện ích Chrome "ABS — Cầu nối cổng thuế" ──
# Mã sinh từ khóa công khai trong chrome-extension/manifest.json. Đổi khóa thì mã đổi theo.
NEXT_PUBLIC_TOKHAI_EXT_ID=pojbjgeiaeajpfpbflbicidpbhpeaolg

# ── Mã hóa mật khẩu tài khoản thuế của khách (AES-256-GCM) — phân hệ Tờ khai ──
# Sinh một chuỗi ngẫu nhiên MỚI tối thiểu 32 ký tự, cất vào nơi an toàn: MẤT LÀ MẤT HẾT mật khẩu
# đã lưu. TAX_ENC_KEY_OLD chỉ dùng khi xoay khóa.
TAX_ENC_KEY=
TAX_ENC_KEY_OLD=

# ── (Không bắt buộc) Chuỗi kết nối Postgres trực tiếp — Supabase → Settings → Database ──
# Project chỉ có IPv6 nên KHÔNG kết nối được từ máy dev thông thường; mọi thay đổi schema làm
# bằng tay trong Supabase → SQL Editor (xem BAN-GIAO.md mục B6).
SUPABASE_DB_URL=
